# DATABASE_URL must include the app database name (e.g. gate_crown). Migrate creates it if missing (role needs CREATEDB).
# Edit user/password/host as needed. Tracked so clones get defaults.
DATABASE_URL=postgresql://localhost:5432/gate_crown

PORT=8080
ENV=development

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION_HOURS=24

FRONTEND_URL=http://localhost:5173
