# =============================================================================
# Database (required) — DATABASE_URL must include the *target* database name.
# `go run ./cmd/migrate up` creates that database if it does not exist (role needs CREATEDB),
# then applies migrations (tables, seed users). Uses maintenance DB below to run CREATE DATABASE.
# =============================================================================
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/gate_crown

# Optional: database to connect to for CREATE DATABASE only (default: postgres)
# POSTGRES_MAINTENANCE_DATABASE=postgres

# Server
PORT=8080
ENV=development

# JWT (required for login)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION_HOURS=24

# CORS — comma-separated origins (e.g. your frontend URL)
FRONTEND_URL=http://localhost:5173
